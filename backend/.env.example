# ========================================================
# QR Master Pro — Backend Environment Configuration
# ========================================================
# PORT: The port this gateway service will listen on
PORT=3000

# CLOUDINARY CONFIGURATION (Required for real image hosting & remote deletion)
# Find these credentials in your Cloudinary Dashboard under Settings > Access Keys:
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# GATEWAY BASE URL (Required for generating shareable QR destination URLs)
# For local Android emulator development: http://10.0.2.2:3000
# For local physical phone on Wi-Fi: http://<YOUR_COMPUTER_LOCAL_IP>:3000
# For production (Render, Railway, Cloud Run): https://your-domain.com
BASE_URL=http://localhost:3000

# SECURITY SIGNING KEY (Used for generating tamper-proof asset tokens)
EXPIRY_SIGNING_SECRET=replace_with_a_secure_random_64_character_string

# RATE LIMITING & SECURITY
MAX_UPLOAD_SIZE_MB=10
DEFAULT_EXPIRY_HOURS=720
